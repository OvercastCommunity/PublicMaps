<map proto="1.5.0">
<name>Dawnskirr</name>
<version>1.2.5</version>
<created>2015-04-03</created>
<objective>Capture the enemy's wool and bring it to your monument!</objective>
<include id="gapple-kill-reward"/>
<authors>
    <author uuid="2ca8072f-74be-4798-85b8-bbce03aa91af"/> <!-- Tywnis -->
</authors>
<teams>
    <team id="red-team" color="dark red" max="12" max-overfill="16">Red</team>
    <team id="blue-team" color="blue" max="12" max-overfill="16">Blue</team>
</teams>
<kits>
    <kit id="spawn-kit">
        <clear/>
        <item slot="0" unbreakable="true" material="stone sword"/>
        <item slot="1" unbreakable="true" enchantment="arrow infinite" material="bow"/>
        <item slot="2" unbreakable="true" material="iron pickaxe"/>
        <item slot="3" unbreakable="true" material="iron axe"/>
        <item slot="4" amount="64" damage="2" material="wood"/>
        <item slot="5" amount="32" team-color="true" material="stained glass"/>
        <item slot="7" enchantment="knockback" material="stick"/>
        <item slot="8" material="golden apple"/>
        <item slot="28" material="arrow"/>
        <chestplate team-color="true" unbreakable="true" material="leather chestplate"/>
        <boots team-color="true" unbreakable="true" material="leather boots"/>
        <effect duration="5s" amplifier="4">damage resistance</effect>
        <effect duration="5s" amplifier="4">heal</effect>
    </kit>
</kits>
<spawns>
    <spawn team="red-team" kit="spawn-kit">
        <regions yaw="-45">
            <point>2023.5,6.5,-1578.5</point>
        </regions>
        <regions yaw="45">
            <point>2105.5,6.5,-1578.5</point>
        </regions>
    </spawn>
    <spawn team="blue-team" kit="spawn-kit">
        <regions yaw="135">
            <point>2105.5,6.5,-1436.5</point>
        </regions>
        <regions yaw="-135">
            <point>2023.5,6.5,-1436.5</point>
        </regions>
    </spawn>
    <default>
        <regions yaw="-90">
            <cylinder base="2030.5,55,-1507.5" radius="2" height="0"/>
        </regions>
    </default>
</spawns>
<filters>
    <deny id="deny-some">
        <any>
            <material>chest</material>
            <material id="only-beacon">beacon</material>
        </any>
    </deny>
</filters>
<regions>
    <negative id="void-area">
        <rectangle min="2024,-1551" max="2105,-1464"/>
    </negative>
    <union id="spawns">
        <union id="red-spawns">
            <circle id="red-spawn-1" center="2105,-1579" radius="10"/>
            <circle id="red-spawn-2" center="2023,-1579" radius="10"/>
        </union>
        <union id="blue-spawns">
            <circle id="blue-spawn-1" center="2023,-1437" radius="10"/>
            <circle id="blue-spawn-2" center="2105,-1437" radius="10"/>
        </union>
    </union>
    <union id="victory-monuments">
        <cylinder id="blue-victory-monument" base="2064.5,0,-1557.5" radius="2" height="13"/>
        <cylinder id="red-victory-monument" base="2064.5,0,-1457.5" radius="2" height="13"/>
    </union>
    <union id="woolrooms">
        <rectangle id="red-woolroom" min="2078.5,-1591.5" max="2046.5,-1607.5"/>
        <rectangle id="blue-woolroom" min="2078.5,-1423.5" max="2046.5,-1407.5"/>
    </union>
    <apply region="red-spawns" enter="red-team" message="You may not enter the enemy's spawn!"/>
    <apply region="blue-spawns" enter="blue-team" message="You may not enter the enemy's spawn!"/>
    <apply region="spawns" block="never" message="You may not modify the spawns!"/>
    <apply region="victory-monuments" block="never" message="You may not modify the victory monument!"/>
    <apply region="blue-woolroom" enter="red-team" message="You may not enter your own wool room!"/>
    <apply region="red-woolroom" enter="blue-team" message="You may not enter your own wool room!"/>
    <apply region="blue-woolroom" block="deny(blue-team)" enter="red-team" use="red-team" message="You may not modify your own wool room!"/>
    <apply region="red-woolroom" block="deny(red-team)" enter="blue-team" use="blue-team" message="You may not modify your own wool room!"/>
    <apply region="void-area" block="deny(void)" message="You may not modify the void area!"/>
    <apply region="woolrooms" block-break="deny-some"/>
    <apply use="deny(only-beacon)"/>
</regions>
<wools>
    <wool team="blue-team" color="light blue" location="2064.5,18,-1414.5">
        <monument>
            <block>2064.5,10,-1457.5</block>
        </monument>
    </wool>
    <wool team="red-team" color="red" location="2064.5,18,-1600.5">
        <monument>
            <block>2064.5,10,-1557.5</block>
        </monument>
    </wool>
</wools>
<falling-blocks>
    <!-- make glass fall if it is not attached to wood or glass -->
    <rule>
        <filter>
            <material>wood</material>
        </filter>
        <sticky>
            <any>
                <material>wood</material>
                <material>stained glass</material>
                <material>grass</material>
                <material>dirt</material>
                <material>gravel</material>
                <material>sand</material>
                <material>log</material>
                <material>leaves</material>
                <material>nether brick</material>
                <material>step</material>
                <material>iron block</material>
                <material>bedrock</material>
                <material>fence</material>
                <material>double step</material>
                <material>piston base</material>
                <material>wool</material>
                <material>redstone block</material>
                <material>redstone lamp off</material>
                <material>redstone lamp on</material>
                <material>log 2</material>
                <material>workbench</material>
                <material>wood stairs</material>
                <material>wood step</material>
                <material>wood double step</material>
            </any>
        </sticky>
    </rule>
    <rule>
        <filter>
            <material>stained glass</material>
        </filter>
        <sticky>
            <any>
                <material>wood</material>
                <material>stained glass</material>
                <material>grass</material>
                <material>dirt</material>
                <material>gravel</material>
                <material>sand</material>
                <material>log</material>
                <material>leaves</material>
                <material>nether brick</material>
                <material>step</material>
                <material>iron block</material>
                <material>bedrock</material>
                <material>fence</material>
                <material>double step</material>
                <material>piston base</material>
                <material>wool</material>
                <material>redstone block</material>
                <material>redstone lamp off</material>
                <material>redstone lamp on</material>
                <material>log 2</material>
                <material>workbench</material>
                <material>wood stairs</material>
                <material>wood step</material>
                <material>wood double step</material>
            </any>
        </sticky>
    </rule>
</falling-blocks>
<toolrepair>
    <tool>stone sword</tool>
    <tool>bow</tool>
    <tool>iron pickaxe</tool>
    <tool>iron axe</tool>
    <tool>arrow</tool>
</toolrepair>
<itemremove>
    <item>stick</item>
    <item>wool</item>
    <item>cobblestone</item>
    <item>dirt</item>
    <item>sand</item>
    <item>gravel</item>
    <item>log</item>
    <item>leather chestplate</item>
    <item>leather boots</item>
    <item>obsidian</item>
    <item>string</item>
</itemremove>
<itemkeep>
    <item>wood</item>
    <item>stained glass</item>
    <item>golden apple</item>
</itemkeep>
<kill-rewards>
    <kill-reward>
        <item amount="16" damage="2" material="wood"/>
        <item amount="8" team-color="true" material="stained glass"/>
    </kill-reward>
</kill-rewards>
<maxbuildheight>32</maxbuildheight>
<timelock>off</timelock>
<hunger>
    <depletion>off</depletion>
</hunger>
</map>
