<map proto="1.5.0">
<name>Depths</name>
<version>1.0.3</version>
<created>2017-02-03</created> <!-- Earliest GitHub issue in Stratus map submissions -->
<objective>Destroy the enemy team's two monuments!</objective>
<include id="gapple-kill-reward"/>
<authors>
    <author uuid="b03360db-b8cd-49de-8ba1-b7920c2238a9"/> <!-- Obelistics -->
</authors>
<teams>
    <team id="red-team" color="dark red" max="10">Red</team>
    <team id="blue-team" color="blue" max="10">Blue</team>
</teams>
<kits>
    <kit id="spawn-kit" force="true">
        <clear/>
        <item slot="0" material="iron sword" unbreakable="true"/>
        <item slot="1" material="bow" unbreakable="true"/>
        <item slot="2" material="iron pickaxe" unbreakable="true"/>
        <item slot="3" material="iron axe" unbreakable="true"/>
        <item slot="30" material="iron spade" unbreakable="true"/>
        <item slot="4" material="wood" damage="5" amount="64"/>
        <item slot="5" material="stained clay" team-color="true" amount="32"/>
        <item slot="7" material="arrow" amount="48"/>
        <item slot="8" material="golden apple" amount="1"/>
        <helmet unbreakable="true" team-color="true" material="leather helmet"/>
        <chestplate unbreakable="true" team-color="true" enchantments="projectile protection;blast protection" material="leather chestplate"/>
        <effect duration="5s">damage resistance</effect>
    </kit>
</kits>
<spawns>
    <spawn team="red-team" kit="spawn-kit">
        <region yaw="-90">
            <point>986.5,14,-973.5</point>
        </region>
    </spawn>
    <spawn team="blue-team" kit="spawn-kit">
        <region yaw="90">
            <point>906.5,14,-973.5</point>
        </region>
    </spawn>
    <default>
        <region yaw="180">
            <cylinder base="946.5,37,-973.5" radius="3" height="0"/>
        </region>
    </default>
</spawns>
<filters>
    <all id="only-gold-renew">
        <material id="only-gold">gold block</material>
        <cause>world</cause>
    </all>
    <material id="lime-stained-clay">stained clay:5</material>
</filters>
<regions>
    <negative id="void-area">
        <union id="buildable-area">
            <rectangle min="978,-1062" max="915,-1029"/>
            <rectangle min="915,-885" max="978,-918"/>
        </union>
    </negative>
    <union id="spawns">
        <circle id="red-spawn" center="986.5,-973.5" radius="12"/>
        <circle id="blue-spawn" center="906.5,-973.5" radius="12"/>
    </union>
    <union id="spawns-upper">
        <cylinder id="red-spawn-upper" base="986.5,11,-973.5" radius="12" height="30"/>
        <cylinder id="blue-spawn-upper" base="906.5,11,-973.5" radius="12" height="30"/>
    </union>
    <cuboid id="red-north-monument" min="988,23,-1051" max="985,14,-1054"/>
    <cuboid id="red-south-monument" min="988,23,-896" max="985,14,-893"/>
    <cuboid id="blue-north-monument" min="905,23,-1051" max="908,14,-1054"/>
    <cuboid id="blue-south-monument" min="905,23,-896" max="908,14,-893"/>
    <apply block-place="only-gold-renew" block-break="only-gold" region="spawns" message="You may only break gold blocks in the spawn!"/>
    <apply enter="red-team" region="red-spawn-upper" message="You may not enter the enemy team's spawn!"/>
    <apply enter="blue-team" region="blue-spawn-upper" message="You may not enter the enemy team's spawn!"/>
    <apply block-place="deny(void)" block-break="deny(all(void, not(lime-stained-clay)))" region="void-area" message="You may not edit the void!"/>
</regions>
<destroyables materials="ender stone" show-progress="true">
    <destroyables name="North Monument">
        <destroyable owner="red-team" region="red-north-monument"/>
        <destroyable owner="blue-team" region="blue-north-monument"/>
    </destroyables>
    <destroyables name="South Monument">
        <destroyable owner="red-team" region="red-south-monument"/>
        <destroyable owner="blue-team" region="blue-south-monument"/>
    </destroyables>
</destroyables>
<toolrepair>
    <tool>iron sword</tool>
    <tool>bow</tool>
    <tool>iron pickaxe</tool>
    <tool>iron axe</tool>
    <tool>iron spade</tool>
</toolrepair>
<itemkeep>
    <item>arrow</item>
    <item>wood</item>
    <item>stained clay</item>
    <item>golden apple</item>
</itemkeep>
<itemremove>
    <item>leather helmet</item>
    <item>leather chestplate</item>
    <item>sand</item>
    <item>double step</item>
    <item>step</item>
    <item>leaves</item>
    <item>melon</item>
    <item>huge mushroom 1</item>
    <item>brown mushroom</item>
    <item>ender stone</item>
    <item>cobble wall</item>
</itemremove>
<renewables>
    <renewable region="spawns-upper" renew-filter="only-gold"/>
</renewables>
<item-mods>
    <rule>
        <match>
            <material>gold helmet</material>
            <material>gold leggings</material>
            <material>gold boots</material>
        </match>
        <modify unbreakable="true"/>
    </rule>
    <rule>
        <match>
            <material>gold chestplate</material>
        </match>
        <modify unbreakable="true">
            <enchantment>projectile protection</enchantment>
            <enchantment>blast protection</enchantment>
        </modify>
    </rule>
</item-mods>
<kill-rewards>
    <kill-reward>
        <item amount="12" material="arrow"/>
        <item amount="16" material="wood" damage="5"/>
    </kill-reward>
</kill-rewards>
<hunger>
    <depletion>off</depletion>
</hunger>
<maxbuildheight>30</maxbuildheight>
<!--<broadcasts>
    <tip after="30s">There are 2 elytra's on both teams side. Use them wisely!</tip>
</broadcasts>-->
</map>
