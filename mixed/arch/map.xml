<map proto="1.5.1">
<name>Arch</name>
<version>1.0.15</version>
<objective>Capture both wools and destroy the end stone monument!</objective>
<created>2016-12-11</created>
<phase>staging</phase>
<include id="gapple-kill-reward"/>
<authors>
    <author uuid="74e59389-2b3e-490d-954a-a7af1fb1eded"/> <!-- Dowly_ -->
</authors>
<contributors>
    <contributor uuid="38ab65dd-95f9-406f-917c-6accc995421f" contribution="XML"/> <!-- GoldenOre -->
    <contributor uuid="48924ea3-3aad-4e16-838c-368d8d9e0a25" contribution="XML"/> <!-- Matic0B -->
    <contributor uuid="8f6695e0-5a11-4feb-b44f-3b01ad7d7d85"/> <!-- barrecca -->
    <contributor uuid="21a798e3-e1be-4eea-9104-615191d87139"/> <!-- _Banana_Juice_ -->
    <contributor uuid="62b6d081-8df8-4c09-aa15-71141ca7df76"/> <!-- Arzanex -->
    <contributor uuid="72be230a-0615-4b8e-960e-fe6f8afbc1b0"/> <!-- ZodiacNeo -->
    <contributor uuid="a576ef17-2c05-4a4a-8cf1-50f62ef4aacd" contribution="Observer Spawn"/> <!-- WidPato -->
