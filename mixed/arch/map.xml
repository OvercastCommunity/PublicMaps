</contributors>
<rules>
    <rule>Underbridging is not allowed.</rule>
</rules>
<teams>
    <team id="red-team" color="dark red" max="22">Red</team>
    <team id="blue-team" color="blue" dye-color="light blue" max="22">Blue</team>
</teams>
<kits>
    <kit id="spawn-kit">
        <clear/>
        <item slot="0" unbreakable="true" material="iron sword"/>
        <item slot="1" unbreakable="true" enchantment="infinity" material="bow"/>
        <item slot="2" unbreakable="true" material="iron pickaxe"/>
        <item slot="3" unbreakable="true" enchantment="efficiency" material="iron axe"/>
        <item slot="4" amount="48" damage="2" material="wood"/>
        <item slot="5" amount="16" material="glass"/>
        <item slot="7" material="bucket"/>
        <item slot="8" material="golden apple"/>
        <item slot="28" material="arrow"/>
        <item slot="30" unbreakable="true" material="iron spade"/>
        <effect duration="4s" amplifier="5">damage resistance</effect>
    </kit>
    <!-- separate kits for armor colors are intentional -->
    <kit id="red-kit" parent="spawn-kit">
        <chestplate unbreakable="true" color="993333" material="leather chestplate"/>
        <boots unbreakable="true" color="993333" material="leather boots"/>
    </kit>
    <kit id="blue-kit" parent="spawn-kit">
        <chestplate unbreakable="true" color="6699D8" material="leather chestplate"/>
        <boots unbreakable="true" color="6699D8" material="leather boots"/>
    </kit>
</kits>
<spawns>
    <spawn team="red-team" kit="red-kit" yaw="-90">
        <region>
            <point>-27,15.2,3</point>
        </region>
    </spawn>
    <spawn team="blue-team" kit="blue-kit" yaw="90">
        <region>
            <point>121,15.2,3</point>
        </region>
    </spawn>
    <default yaw="90">
        <region>
            <point>47,48.2,3</point>
        </region>
    </default>
</spawns>
<filters>
    <!-- used with deny inline filters to prevent block destruction caused by water flow -->
    <all id="not-water-cause-world">
        <not>
            <any>
                <material>water</material>
                <material>stationary water</material>
            </any>
        </not>
        <cause>world</cause>
    </all>
    <material id="chest">chest</material>
    <material id="only-iron">iron block</material>
    <material id="only-air">air</material>
    <material id="only-cobweb">web</material>
    <material id="trap-door">trap door</material>
    <material id="wall-sign">wall sign</material>
    <carrying id="eff-carrying" ignore-metadata="true" ignore-enchantments="false">
        <item material="iron pickaxe" enchantment="efficiency:2"/>
    </carrying>
    <carrying id="no-eff-carrying" ignore-metadata="true" ignore-enchantments="false">
        <item material="iron pickaxe"/>
    </carrying>
    <any id="efficiency-filter">
        <all>
            <team>red-team</team>
            <resize min="5,6,5" max="5,4,5" region="blue-monument"/>
        </all>
        <all>
            <team>blue-team</team>
            <resize min="5,6,5" max="5,4,5" region="red-monument"/>
        </all>
    </any>
    <not id="water-lane-filter">
        <all>
            <any>
                <material>water</material>
                <material>stationary water</material>
            </any>
            <cause>world</cause>
        </all>
    </not>
    <time id="after-25m">25m</time>
    <time id="after-45m">45m</time>
</filters>
<variables>
    <variable id="eff_mode" scope="match"/>
    <variable id="water_lane_mode" scope="match"/>
</variables>
<actions>
    <action id="activate-eff-mode" scope="player" expose="true">
        <enchant-item enchantment="efficiency" level="2" ignore-metadata="true">
            <find material="iron pickaxe"/>
        </enchant-item>
    </action>
    <action id="deactivate-eff-mode" scope="player" expose="true">
        <enchant-item enchantment="efficiency" level="0" ignore-metadata="true">
            <find material="iron pickaxe"/>
        </enchant-item>
    </action>
    <action id="activate-water-lane-mode" scope="match" expose="true">
        <fill region="water-lane-fill-region" material="water" filter="only-air"/> <!-- place water lanes -->
        <fill region="void-guideline" material="air" filter="only-cobweb"/> <!-- remove legacy void guidelines -->
    </action>
    <trigger scope="player" filter="all(efficiency-filter,any(all(not(eff_mode=0),no-eff-carrying),all(not(eff_mode=1),eff-carrying)))" action="activate-eff-mode"/>
    <trigger scope="player" filter="all(not(efficiency-filter),eff-carrying)" action="deactivate-eff-mode"/>
    <trigger scope="match" filter="water_lane_mode=1" action="activate-water-lane-mode"/>
</actions>
