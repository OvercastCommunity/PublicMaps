            <block>-31,16,5</block>
        </monument>
    </wool>
    <wool team="blue-team" color="pink" location="-58,16,19">
        <monument>
            <block>124,16,5</block>
        </monument>
    </wool>
    <wool team="blue-team" color="magenta" location="-58,16,-13">
        <monument>
            <block>124,16,0</block>
        </monument>
    </wool>
</wools>
<destroyables name="Monument" material="ender stone" show-progress="true" mode-changes="true">
    <destroyable owner="red-team" region="red-monument"/>
    <destroyable owner="blue-team" region="blue-monument"/>
</destroyables>
<modes>
    <mode name="`dEfficiency II`3 near the `6monuments" action="eff_mode:=1" after="20m" show-before="1m"/>
    <mode name="`aDiagonal `bwater lanes `3added" action="water_lane_mode:=1" after="25m" show-before="5m"/>
</modes>
<renewables>
    <renewable rate="2.5" region="bulidable-area" renew-filter="only-iron" replace-filter="only-air"/>
</renewables>
<toolrepair>
    <tool>iron sword</tool>
    <tool>bow</tool>
    <tool>iron pickaxe</tool>
    <tool>iron axe</tool>
    <tool>iron spade</tool>
    <tool>arrow</tool>
</toolrepair>
<itemremove>
